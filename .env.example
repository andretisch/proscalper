# ProScalp — local secrets (не коммитить)

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Bybit API ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# --- Ollama Cloud ---
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:cloud
OLLAMA_HOST=https://ollama.com

# --- Email (SMTP) ---
EMAIL_LOGIN=
EMAIL_PASSWORD=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=
EMAIL_TO=

# --- Proxy (optional) ---
# Один URL для всех HTTP(S)-клиентов (Bybit, Ollama, Telegram):
PROXY_URL=
# Или раздельно:
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1

# --- Runtime ---
MODE=paper
PAPER_FEE_BUFFER_MULT=3.0
MAX_SECONDS_WITHOUT_IMPULSE=90
MAX_PARALLEL_SYMBOLS=2
MAX_CONSECUTIVE_LOSSES=3
DEPOSIT_USDT=100
LEVERAGE=3
RISK_PER_TRADE_PCT=0.5
DAILY_LOSS_LIMIT_PCT=2.0
PLAYBOOK_VERSION=0.1
