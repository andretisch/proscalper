# ProScalp — local secrets (не коммитить)

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Bybit API ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# --- Ollama Cloud ---
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:cloud
OLLAMA_HOST=https://ollama.com

# --- Email (SMTP) ---
EMAIL_LOGIN=
EMAIL_PASSWORD=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=
EMAIL_TO=

# --- Proxy (optional) ---
# Один URL для всех HTTP(S)-клиентов (Bybit, Ollama, Telegram):
PROXY_URL=
# Или раздельно:
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1

# --- Runtime ---
MODE=paper
PAPER_FEE_BUFFER_MULT=3.0
# Окно на развитие сетапа: при 90с половина сделок закрывалась «вничью»,
# заплатив полную комиссию
MAX_SECONDS_WITHOUT_IMPULSE=300
MAX_PARALLEL_SYMBOLS=2
MAX_CONSECUTIVE_LOSSES=3
# Комиссия считается от номинала, а риск — от стопа: при узком стопе
# round-trip съедает непропорционально большую долю риска
MAX_FEE_SHARE_OF_RISK=0.20
# Сторож против бесшумных зависаний на сетевых вызовах
WATCHDOG_TIMEOUT_SEC=600
LOG_LEVEL=INFO

# --- Сеть: прокси рвёт соединения, это норма ---
# Мёртвый прокси видно сразу, ждать его незачем
HTTP_CONNECT_TIMEOUT_SEC=6
HTTP_READ_TIMEOUT_SEC=15
# Повтор при обрыве; на GET дополнительно работают ретраи пула соединений
HTTP_RETRY_ATTEMPTS=3
# Страховка: CONNECT к прокси и TLS-рукопожатие проходят мимо таймаутов requests
SOCKET_TIMEOUT_SEC=90
# Бюджет на цикл: лучше пропустить символ, чем словить перезапуск по сторожу
CYCLE_BUDGET_SEC=240

# --- Диск ---
# Снимок стакана весит ~7.5 КБ, за сутки набегает ~70 МБ. Сигналам нужны
# минуты истории, глубина — только для разбора сделок постфактум.
ORDERBOOK_RETENTION_DAYS=3
# Стакан testnet синтетический — рыночные данные берём с mainnet
MARKET_DATA_MAINNET=true
TAKER_FEE_RATE=0.00055
SYMBOL_COOLDOWN_SEC=600

# --- Поиск лимитной плотности (ЛП) ---
# Глубина стакана: на BTC 25 уровней — это 0.006% цены, плотность там не видна
BOOK_DEPTH_LIMIT=200
# Полоса, в которой считается глубина стороны
WALL_SCAN_PCT=0.6
# Плотность отслеживаем заранее, пока цена ещё не подошла
WALL_MIN_DIST_PCT=0.02
WALL_MAX_DIST_PCT=0.45
# Уровень должен держать долю глубины стороны, а не быть просто крупным
WALL_MIN_DEPTH_SHARE=0.15
WALL_MIN_RATIO=8.0
# Выдержка против спуфинга: сколько раз и как долго плотность стоит
WALL_MIN_OBSERVATIONS=2
WALL_MIN_AGE_SEC=45
# Съеденную плотность не торгуем
WALL_MIN_HELD_SHARE=0.6
# Вход только когда цена подошла к уровню
WALL_APPROACH_PCT=0.12

# --- Фильтр окупаемости ---
# Минимальное отношение цели к риску
MIN_RR=1.5
# Окно замера реального размаха цены
ROOM_WINDOW_SEC=900

# --- Отбор символов «в игре» ---
MIN_TURNOVER_USD=20000000
MIN_RANGE24_PCT=3.0
DEPOSIT_USDT=100
LEVERAGE=3
RISK_PER_TRADE_PCT=0.5
DAILY_LOSS_LIMIT_PCT=2.0
PLAYBOOK_VERSION=0.1
